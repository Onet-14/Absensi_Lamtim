<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Catatan Kinerja Harian — Penampung Draf e-Kinerja</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --paper:#F4F0E6; --sheet:#FBF8F1; --card:#FFFDF6; --ink:#1D1B16; --ink-soft:#57534A;
  --green:#2F5D3E; --green-soft:#DFEBDF; --terra:#B4531F; --terra-soft:#F6E4D6;
  --mono:'IBM Plex Mono',monospace; --sans:'Plus Jakarta Sans',sans-serif;
}
body{font-family:var(--sans);color:var(--ink);background-color:var(--paper);
  background-image:radial-gradient(rgba(29,27,22,.055) 1px,transparent 1.3px);background-size:22px 22px;
  padding:30px 18px 70px;line-height:1.5}
::selection{background:var(--green);color:#fff}
[hidden]{display:none!important}
.mono{font-family:var(--mono)}
.page{max-width:1060px;margin:0 auto}

/* ---------- KOP SURAT ---------- */
.kop{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;flex-wrap:wrap}
.kop-tag{display:inline-block;font-family:var(--mono);font-size:11px;letter-spacing:.22em;
  border:1.5px solid var(--ink);background:var(--card);padding:5px 12px;box-shadow:3px 3px 0 var(--ink);margin-bottom:14px}
.kop h1{font-size:clamp(30px,5.4vw,50px);font-weight:800;text-transform:uppercase;line-height:.95;letter-spacing:-.01em}
.kop h1 em{font-style:normal;color:var(--green)}
.kop-sub{margin-top:10px;font-size:14px;color:var(--ink-soft);max-width:520px}
.kop-meta{text-align:right;display:flex;flex-direction:column;gap:4px;align-items:flex-end}
.kop-form{font-family:var(--mono);font-size:11px;letter-spacing:.18em;border:1.5px solid var(--ink);
  background:var(--green);color:#F4F0E6;padding:4px 10px}
.kop-clock{font-family:var(--mono);font-size:26px;font-weight:600;font-variant-numeric:tabular-nums}
.kop-date{font-size:12.5px;color:var(--ink-soft)}
.rule-double{margin-top:20px;border-top:3px solid var(--ink);border-bottom:1px solid var(--ink);height:6px}

/* ---------- TAB & LEMBAR ---------- */
.tabs{display:flex;gap:6px;margin-top:26px;position:relative;z-index:2;flex-wrap:wrap}
.tab{display:flex;align-items:center;gap:9px;font:700 13px var(--sans);letter-spacing:.06em;text-transform:uppercase;
  border:1.5px solid var(--ink);border-bottom:none;background:#EFEADB;color:var(--ink);
  padding:11px 18px;border-radius:10px 10px 0 0;cursor:pointer;transform:translateY(4px);
  transition:transform .18s,background .18s,color .18s}
.tab svg{width:15px;height:15px}
.tab-no{font-family:var(--mono);font-size:11px;opacity:.55}
.tab:hover{transform:translateY(2px)}
.tab.active{background:var(--green);color:#F4F0E6;transform:translateY(0)}
.tab.active .tab-no{opacity:.8}
.sheet{border:1.5px solid var(--ink);background:var(--sheet);box-shadow:8px 8px 0 rgba(29,27,22,.1);padding:26px;position:relative;z-index:1}
@media(max-width:640px){.sheet{padding:16px}}

/* ---------- TOMBOL ---------- */
.btn{display:inline-flex;align-items:center;gap:8px;font:700 13.5px var(--sans);border:1.5px solid var(--ink);
  background:var(--card);color:var(--ink);padding:10px 18px;border-radius:7px;cursor:pointer;
  box-shadow:3px 3px 0 var(--ink);transition:transform .12s,box-shadow .12s;user-select:none}
.btn svg{width:16px;height:16px}
.btn:hover{transform:translate(-1px,-1px);box-shadow:4px 4px 0 var(--ink)}
.btn:active{transform:translate(2px,2px);box-shadow:0 0 0 var(--ink)}
.btn-primary{background:var(--green);color:#F4F0E6}
.btn-danger{background:var(--terra);color:#FDF6EE}
.btn-ghost{box-shadow:none;background:transparent}
.btn-ghost:hover{transform:none;background:#EFEADB;box-shadow:none}
.btn-sm{padding:7px 12px;font-size:12.5px}
.icon-btn{border:1.5px solid var(--ink);background:var(--card);width:30px;height:30px;border-radius:6px;
  display:inline-grid;place-items:center;cursor:pointer;color:var(--terra);transition:.15s}
.icon-btn:hover{background:var(--terra);color:#fff}
.icon-btn svg{width:14px;height:14px}

/* ---------- PANEL ---------- */
.panel{border:1.5px solid var(--ink);background:var(--card);border-radius:10px;padding:20px 22px;box-shadow:4px 4px 0 var(--ink);margin-bottom:20px}
.panel-title{display:flex;align-items:center;gap:9px;font:800 13px var(--sans);letter-spacing:.14em;text-transform:uppercase;margin-bottom:16px}
.panel-title svg{width:16px;height:16px;color:var(--green)}
.panel-title .spacer{flex:1;border-top:1px dashed rgba(29,27,22,.35)}

/* ---------- STATISTIK ---------- */
.statbar{display:flex;flex-wrap:wrap;border:1.5px solid var(--ink);background:var(--card);border-radius:10px;
  box-shadow:4px 4px 0 var(--ink);margin-bottom:20px;overflow:hidden}
.stat{padding:16px 26px;border-left:1.5px solid var(--ink)}
.stat:first-child{border-left:none}
.stat b{display:block;font-family:var(--mono);font-size:30px;font-weight:600;line-height:1.1}
.stat span{font-size:10.5px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-soft)}
.stat.hl b{color:var(--green)}
.stat.hl2 b{color:var(--terra)}
@media(max-width:640px){.stat{padding:12px 16px}.stat b{font-size:22px}}

/* ---------- KARTU IDENTITAS ---------- */
.idcard{border:1.5px solid var(--ink);background:var(--green);color:#F4F0E6;border-radius:10px;
  padding:20px 22px;box-shadow:4px 4px 0 var(--ink);margin-bottom:20px;position:relative;overflow:hidden}
.idcard::after{content:"";position:absolute;right:-40px;top:-40px;width:150px;height:150px;
  border:1.5px solid rgba(244,240,230,.25);border-radius:50%;pointer-events:none}
.idcard-top{font:700 10.5px var(--mono);letter-spacing:.2em;opacity:.85;display:flex;gap:8px;align-items:center;margin-bottom:12px}
.idcard-top svg{width:14px;height:14px}
.idcard-name{font-size:22px;font-weight:800}
.idcard-nip{font-family:var(--mono);font-size:13px;opacity:.9;margin-top:2px}
.idcard-role{font-size:13px;opacity:.85;margin-top:6px}
.idcard .btn{margin-top:14px;background:transparent;color:#F4F0E6;border-color:#F4F0E6;box-shadow:3px 3px 0 rgba(0,0,0,.25)}
.idcard .btn:hover{background:rgba(255,255,255,.12);transform:translate(-1px,-1px)}

/* ---------- EMPTY STATE ---------- */
.empty{border:1.5px dashed var(--ink);border-radius:10px;padding:34px 20px;text-align:center;color:var(--ink-soft);font-size:14px}
.empty svg{width:34px;height:34px;margin-bottom:10px;color:var(--ink)}
.empty b{display:block;color:var(--ink);margin-bottom:4px}
.empty .btn{margin-top:16px}

/* ---------- DAFTAR TERAKHIR ---------- */
.recent-item{display:flex;gap:16px;align-items:flex-start;padding:13px 2px;border-bottom:1.5px dashed rgba(29,27,22,.28)}
.recent-item:last-child{border-bottom:none;padding-bottom:2px}
.recent-date{min-width:46px;text-align:center;border:1.5px solid var(--ink);border-radius:7px;overflow:hidden;background:var(--sheet)}
.recent-date b{display:block;background:var(--ink);color:#F4F0E6;font-family:var(--mono);font-size:14px;padding:2px 0}
.recent-date span{display:block;font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;padding:2px 4px}
.recent-body{flex:1;min-width:0}
.recent-task{font-weight:600;font-size:14.5px}
.recent-meta{font-size:12px;color:var(--ink-soft);font-family:var(--mono);margin-top:3px}

.badge{display:inline-block;font:700 10.5px var(--sans);letter-spacing:.08em;text-transform:uppercase;
  border:1.5px solid var(--ink);border-radius:999px;padding:3px 10px;white-space:nowrap}
.b-traj{background:var(--green-soft);color:var(--green)}
.b-non{background:var(--terra-soft);color:var(--terra)}

/* ---------- STEPPER ---------- */
.stepper{display:flex;align-items:stretch;margin-bottom:22px}
.step{display:flex;align-items:center;gap:11px;border:1.5px solid var(--ink);background:var(--card);padding:10px 18px 10px 12px;border-radius:9px}
.step-num{width:28px;height:28px;flex:none;border:1.5px solid var(--ink);border-radius:50%;display:grid;place-items:center;font:600 13px var(--mono)}
.step-num svg{width:14px;height:14px}
.step b{display:block;font-size:13.5px}
.step small{display:block;font-size:11px;color:var(--ink-soft)}
.step-line{flex:1;border-top:1.5px dashed rgba(29,27,22,.4);margin:auto 14px;min-width:16px}
.step.active{background:var(--green);color:#F4F0E6}
.step.active small{color:rgba(244,240,230,.75)}
.step.active .step-num{background:#F4F0E6;color:var(--green);border-color:#F4F0E6}
.step.done .step-num{background:var(--ink);color:#F4F0E6;border-color:var(--ink)}
.step .chk{display:none}
.step.done .chk{display:block}
.step.done .num{display:none}
@media(max-width:640px){.step small{display:none}.step{padding:9px 12px 9px 10px}}

/* ---------- FORM ---------- */
.grid{display:grid;grid-template-columns:repeat(12,1fr);gap:16px}
.f-2{grid-column:span 2}.f-3{grid-column:span 3}.f-4{grid-column:span 4}.f-5{grid-column:span 5}
.f-6{grid-column:span 6}.f-7{grid-column:span 7}.f-8{grid-column:span 8}.f-12{grid-column:span 12}
@media(max-width:760px){.grid [class*='f-']{grid-column:span 12}}
label{display:block;font:700 10.5px var(--sans);letter-spacing:.13em;text-transform:uppercase;margin-bottom:7px}
label .opt{color:var(--ink-soft);font-weight:600;letter-spacing:.05em;text-transform:none}
input,select,textarea{width:100%;border:1.5px solid var(--ink);background:var(--card);color:var(--ink);
  font:500 14.5px var(--sans);padding:10px 12px;border-radius:7px;transition:border-color .15s,box-shadow .15s}
input:focus,select:focus,textarea:focus{outline:none;border-color:var(--green);box-shadow:3px 3px 0 rgba(47,93,62,.22)}
input[readonly]{background:#EFEADB;color:var(--ink-soft)}
textarea{min-height:86px;resize:vertical}
.hint{font-size:12px;color:var(--ink-soft);margin-top:6px}
.err{border-color:var(--terra)!important;box-shadow:3px 3px 0 var(--terra-soft)!important}
.form-actions{grid-column:1/-1;display:flex;gap:12px;align-items:center;justify-content:flex-end;flex-wrap:wrap;
  border-top:1.5px dashed rgba(29,27,22,.3);padding-top:18px;margin-top:4px}
.form-actions .note{margin-right:auto;font-size:12px;color:var(--ink-soft)}

/* ---------- CHIP PEGAWAI ---------- */
.chip{display:flex;align-items:center;gap:16px;flex-wrap:wrap;border:1.5px solid var(--ink);
  background:var(--green-soft);border-radius:10px;padding:13px 18px;margin-bottom:20px}
.chip-line{display:flex;align-items:baseline;gap:12px;flex-wrap:wrap}
.chip-line b{font-size:15.5px}
.chip-nip{font-family:var(--mono);font-size:12.5px;color:var(--ink-soft)}
.chip-sub{font-size:12.5px;color:var(--ink-soft)}
.chip .btn{margin-left:auto}

/* ---------- TOOLBAR & TABEL ---------- */
.toolbar{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-bottom:16px}
.toolbar input,.toolbar select{width:auto;min-width:130px;padding:9px 12px;font-size:13.5px}
.toolbar .search{flex:1 1 220px}
.toolbar .group{display:flex;gap:10px;margin-left:auto;flex-wrap:wrap}
.info-count{font-size:12.5px;color:var(--ink-soft);margin-bottom:10px}
.table-wrap{padding:0;overflow:hidden}
.table-scroll{overflow-x:auto}
table{width:100%;border-collapse:collapse;min-width:880px}
th{font:700 10.5px var(--sans);letter-spacing:.12em;text-transform:uppercase;text-align:left;
  padding:13px 14px;background:var(--ink);color:#F4F0E6;white-space:nowrap}
td{padding:12px 14px;border-bottom:1.5px dashed rgba(29,27,22,.22);vertical-align:top;font-size:13.5px}
tr:last-child td{border-bottom:none}
tbody tr:hover{background:#F3EEDF}
.td-sub{font-size:11.5px;color:var(--ink-soft);margin-top:3px}
.td-task{font-weight:600;max-width:340px}
.td-idx{font-family:var(--mono);color:var(--ink-soft)}

/* ---------- TOAST, STEMPEL, MODAL ---------- */
.toast{position:fixed;right:22px;bottom:22px;z-index:120;display:flex;align-items:center;gap:10px;
  background:var(--ink);color:#F4F0E6;padding:13px 18px;border-radius:9px;font-size:14px;font-weight:600;
  box-shadow:4px 4px 0 rgba(29,27,22,.25);transform:translateY(140%);
  transition:transform .35s cubic-bezier(.2,.9,.3,1.1);max-width:min(90vw,380px)}
.toast.show{transform:none}
.toast svg{width:17px;height:17px;flex:none}
.toast.ok svg{color:#8FD6A4}
.toast.bad{background:var(--terra)}
.toast.bad svg{color:#FDEBDD}
.stamp{position:fixed;left:50%;top:44%;z-index:130;transform:translate(-50%,-50%) rotate(-7deg);
  border:3px solid var(--green);outline:1.5px solid var(--green);outline-offset:5px;border-radius:8px;
  padding:14px 30px;display:flex;align-items:center;gap:12px;color:var(--green);
  background:rgba(251,248,241,.92);font:800 21px var(--sans);letter-spacing:.28em;text-transform:uppercase;
  opacity:0;pointer-events:none}
.stamp svg{width:24px;height:24px}
.stamp.show{animation:stampIn .5s cubic-bezier(.2,.85,.3,1.25) forwards}
@keyframes stampIn{
  0%{opacity:0;transform:translate(-50%,-50%) rotate(-7deg) scale(2.1)}
  55%{opacity:1;transform:translate(-50%,-50%) rotate(-7deg) scale(.95)}
  75%{transform:translate(-50%,-50%) rotate(-7deg) scale(1.03)}
  100%{opacity:1;transform:translate(-50%,-50%) rotate(-7deg) scale(1)}}
.modal-back{position:fixed;inset:0;background:rgba(29,27,22,.5);z-index:140;display:grid;place-items:center;padding:20px}
.modal{background:var(--card);border:1.5px solid var(--ink);border-radius:12px;box-shadow:6px 6px 0 var(--ink);max-width:420px;width:100%;padding:22px}
.modal h3{font-size:17px;margin-bottom:8px;display:flex;align-items:center;gap:9px}
.modal h3 svg{width:18px;height:18px;color:var(--terra)}
.modal p{font-size:14px;color:var(--ink-soft)}
.modal-actions{display:flex;justify-content:flex-end;gap:10px;margin-top:20px}

.sec{animation:fadeUp .35s ease both}
@keyframes fadeUp{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
footer{margin-top:26px;text-align:center;font-size:12px;color:var(--ink-soft)}
footer .mono{font-size:11px}

@media print{
  body{background:#fff;padding:0}
  .tabs,.toolbar,.kop-meta,.stamp,.toast,.modal-back,footer,.btn,.icon-btn,.stepper{display:none!important}
  .sheet{border:none;box-shadow:none;padding:0}
  .panel{box-shadow:none}
}
</style>
</head>
<body>
<div class="page">

  <!-- ================= KOP ================= -->
  <header class="kop">
    <div>
      <span class="kop-tag" id="kopInstansi">INSTANSI / UNIT KERJA</span>
      <h1>CATATAN KINERJA<br><em>HARIAN</em></h1>
      <p class="kop-sub">Media penampungan sementara hasil kerja harian — draf pengingat sebelum disalin ke e-Kinerja BKN.</p>
    </div>
    <div class="kop-meta">
      <span class="kop-form">FORM · CKH-01</span>
      <span class="kop-clock" id="jamLive">--.--.--</span>
      <span class="kop-date" id="tglLive">—</span>
    </div>
  </header>
  <div class="rule-double"></div>

  <!-- ================= TAB ================= -->
  <nav class="tabs">
    <button class="tab active" data-tab="dashboard"><i data-lucide="layout-dashboard"></i><span class="tab-no">01</span> Dashboard</button>
    <button class="tab" data-tab="absensi"><i data-lucide="clipboard-list"></i><span class="tab-no">02</span> Absensi</button>
    <button class="tab" data-tab="info"><i data-lucide="table"></i><span class="tab-no">03</span> Info Absensi</button>
  </nav>

  <div class="sheet">
    <main>

      <!-- ================= DASHBOARD ================= -->
      <section id="sec-dashboard" class="sec">
        <div id="dashId"></div>
        <div class="statbar">
          <div class="stat hl"><b id="stTotal">0</b><span>Total Aktivitas</span></div>
          <div class="stat"><b id="stToday">0</b><span>Hari Ini</span></div>
          <div class="stat"><b id="stTraj">0</b><span>Trajectory</span></div>
          <div class="stat hl2"><b id="stNon">0</b><span>Non-Trajectory</span></div>
        </div>
        <div class="panel">
          <div class="panel-title"><i data-lucide="clipboard-list"></i> Aktivitas Terakhir <span class="spacer"></span><span class="mono" style="font-size:11px;color:var(--ink-soft)" id="recentCount"></span></div>
          <div id="recentList"></div>
        </div>
      </section>

      <!-- ================= ABSENSI ================= -->
      <section id="sec-absensi" class="sec" hidden>
        <div class="stepper">
          <div class="step active" id="step1">
            <span class="step-num"><span class="num">1</span><i data-lucide="check" class="chk"></i></span>
            <div><b>Data Pegawai</b><small>Identitas pelapor</small></div>
          </div>
          <div class="step-line"></div>
          <div class="step" id="step2">
            <span class="step-num"><span class="num">2</span><i data-lucide="check" class="chk"></i></span>
            <div><b>Aktivitas Harian</b><small>Isi hasil kerja</small></div>
          </div>
        </div>

        <!-- Langkah 1 : data pegawai -->
        <div class="panel" id="panelPegawai">
          <div class="panel-title"><i data-lucide="user"></i> Data Pegawai</div>
          <form id="formPegawai" class="grid" novalidate autocomplete="off">
            <div class="f-5"><label for="inNama">Nama Pegawai</label><input id="inNama" placeholder="Nama lengkap"></div>
            <div class="f-3"><label for="inNip">NIP</label><input id="inNip" class="mono" inputmode="numeric" maxlength="18" placeholder="18 digit"></div>
            <div class="f-4"><label for="inJabatan">Jabatan</label><input id="inJabatan" placeholder="cth: Staf Administrasi"></div>
            <div class="f-6"><label for="inSubbag">Subbagian / Subbag</label><input id="inSubbag" placeholder="cth: Subbag Keuangan"></div>
            <div class="f-6"><label for="inDivisi">Divisi</label><input id="inDivisi" placeholder="cth: Sekretariat Daerah"></div>
            <div class="form-actions">
              <span class="note">Disimpan di perangkat ini agar tidak perlu diisi ulang.</span>
              <button type="submit" class="btn btn-primary">Lanjut <i data-lucide="arrow-right"></i></button>
            </div>
          </form>
        </div>

        <!-- Ringkasan pegawai setelah "Lanjut" -->
        <div class="chip" id="pegawaiChip" hidden>
          <div>
            <div class="chip-line"><b id="chipNama"></b><span class="chip-nip" id="chipNip"></span></div>
            <div class="chip-sub" id="chipRole"></div>
          </div>
          <button class="btn btn-sm" id="btnUbahPegawai"><i data-lucide="pencil"></i> Ubah</button>
        </div>

        <!-- Langkah 2 : aktivitas harian -->
        <div class="panel" id="panelHarian" hidden>
          <div class="panel-title"><i data-lucide="calendar"></i> Aktivitas Harian</div>
          <form id="formHarian" class="grid" novalidate autocomplete="off">
            <div class="f-4"><label for="inTanggal">Hari / Tanggal</label><input type="date" id="inTanggal"></div>
            <div class="f-2"><label for="inHari">Hari</label><input id="inHari" readonly value="—"></div>
            <div class="f-3"><label for="inJamMulai">Jam</label><select id="inJamMulai"></select></div>
            <div class="f-3"><label for="inJamSelesai">s.d. <span class="opt">(opsional)</span></label><select id="inJamSelesai"></select></div>
            <div class="f-6"><label for="inTupoksi">Tupoksi Pekerjaan</label>
              <input id="inTupoksi" list="dlTupoksi" placeholder="Pilih saran atau tulis sendiri">
              <datalist id="dlTupoksi">
                <option value="Pelayanan Administrasi Perkantoran"></option>
                <option value="Penyusunan Laporan dan Dokumen"></option>
                <option value="Rapat, Koordinasi, dan Konsultasi"></option>
                <option value="Pendataan dan Evaluasi"></option>
                <option value="Pengelolaan Arsip dan Persuratan"></option>
                <option value="Pelayanan Publik"></option>
              </datalist>
            </div>
            <div class="f-6"><label for="inRHK">Rencana Hasil Kerja</label><input id="inRHK" placeholder="cth: Laporan bulanan triwulan I"></div>
            <div class="f-12"><label for="inTugas">Tugas Harian</label><textarea id="inTugas" placeholder="Uraikan pekerjaan yang dikerjakan hari ini..."></textarea></div>
            <div class="f-4"><label for="inKategori">Jenis Kategori</label>
              <select id="inKategori">
                <option value="trajectory">Trajectory</option>
                <option value="non">Non-Trajectory</option>
              </select>
              <p class="hint">Trajectory = bersumber dari rencana hasil kerja. Non-Trajectory = pekerjaan mendadak di luar rencana.</p>
            </div>
            <div class="f-8"><label for="inRealisasi">Realisasi</label>
              <input id="inRealisasi" placeholder="cth: 2 dokumen laporan terselesaikan">
              <p class="hint">Tuliskan kuantitas / output yang dicapai.</p>
            </div>
            <div class="f-12"><label for="inKet">Keterangan <span class="opt">(opsional)</span></label>
              <input id="inKet" placeholder="Catatan tambahan, hambatan, atau tindak lanjut"></div>
            <div class="form-actions">
              <span class="note">Setelah tersimpan, data muncul di menu <b>Info Absensi</b>.</span>
              <button type="button" class="btn btn-ghost" id="btnResetHarian">Bersihkan</button>
              <button type="submit" class="btn btn-primary"><i data-lucide="save"></i> Simpan Catatan</button>
            </div>
          </form>
        </div>
      </section>

      <!-- ================= INFO ABSENSI ================= -->
      <section id="sec-info" class="sec" hidden>
        <div class="toolbar">
          <input type="search" id="fSearch" class="search" placeholder="Cari tugas, tupoksi, RHK, nama pegawai...">
          <select id="fKategori">
            <option value="">Semua kategori</option>
            <option value="trajectory">Trajectory</option>
            <option value="non">Non-Trajectory</option>
          </select>
          <input type="date" id="fTanggal">
          <div class="group">
            <button class="btn btn-sm" id="btnCSV"><i data-lucide="download"></i> CSV</button>
            <button class="btn btn-sm" id="btnPrint"><i data-lucide="printer"></i> Cetak</button>
            <button class="btn btn-sm btn-danger" id="btnHapusSemua"><i data-lucide="trash-2"></i> Hapus Semua</button>
          </div>
        </div>
        <div class="info-count" id="infoCount"></div>
        <div class="panel table-wrap" id="tblPanel">
          <div class="table-scroll">
            <table>
              <thead><tr>
                <th style="width:44px">No</th>
                <th style="width:130px">Tanggal</th>
                <th>Tugas Harian</th>
                <th style="width:132px">Kategori</th>
                <th style="width:180px">Realisasi</th>
                <th style="width:56px">Aksi</th>
              </tr></thead>
              <tbody id="infoBody"></tbody>
            </table>
          </div>
        </div>
        <div class="empty" id="infoEmpty" hidden>
          <i data-lucide="inbox"></i>
          <b>Belum ada catatan</b>
          Isi aktivitas harian lewat menu Absensi, nanti otomatis muncul di sini.
        </div>
      </section>

    </main>
  </div>

  <footer>
    <p>Data disimpan lokal di browser (localStorage) — bersifat sementara &amp; tidak terkirim ke server mana pun.</p>
    <p class="mono">Draf pengingat pengisian e-Kinerja BKN · ekinerja.bkn.go.id</p>
  </footer>
</div>

<!-- Stempel "TERCATAT" -->
<div class="stamp" id="stamp"><i data-lucide="check"></i> Tercatat</div>
<!-- Toast notifikasi -->
<div class="toast" id="toast"></div>
<!-- Modal konfirmasi -->
<div class="modal-back" id="modalBack" hidden>
  <div class="modal">
    <h3><i data-lucide="trash-2"></i> <span id="modalTitle"></span></h3>
    <p id="modalMsg"></p>
    <div class="modal-actions">
      <button class="btn btn-sm" id="modalNo">Batal</button>
      <button class="btn btn-sm btn-danger" id="modalYes">Ya, lanjut</button>
    </div>
  </div>
</div>

<script>
/* ================== UTIL & PENYIMPANAN ================== */
const HARI=['Minggu','Senin','Selasa','Rabu','Kamis','Jumat','Sabtu'];
const BULAN=['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];
const BULAN_S=['Jan','Feb','Mar','Apr','Mei','Jun','Jul','Agu','Sep','Okt','Nov','Des'];
const $=s=>document.querySelector(s), $$=s=>document.querySelectorAll(s);
const LS_P='ckh_pegawai', LS_E='ckh_entries';
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const refreshIcons=()=>{ if(window.lucide) lucide.createIcons(); };

const getPegawai=()=>{try{return JSON.parse(localStorage.getItem(LS_P))||null}catch(_){return null}};
const setPegawai=p=>localStorage.setItem(LS_P,JSON.stringify(p));
const getEntries=()=>{try{return JSON.parse(localStorage.getItem(LS_E))||[]}catch(_){return[]}};
const saveEntries=a=>localStorage.setItem(LS_E,JSON.stringify(a));

function todayISO(){const d=new Date();return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');}
function parseISO(iso){const[y,m,d]=iso.split('-').map(Number);return new Date(y,m-1,d);}
function namaHari(iso){return HARI[parseISO(iso).getDay()];}
function fmtFull(iso){const d=parseISO(iso);return namaHari(iso)+', '+d.getDate()+' '+BULAN[d.getMonth()]+' '+d.getFullYear();}
function fmtShort(iso){const d=parseISO(iso);return d.getDate()+' '+BULAN_S[d.getMonth()]+' '+d.getFullYear();}

/* ================== JAM OTOMATIS (07.30 – 16.30, tiap 30 menit) ================== */
function slotJam(){const a=[];for(let m=450;m<=990;m+=30)a.push(String(Math.floor(m/60)).padStart(2,'0')+'.'+String(m%60).padStart(2,'0'));return a;}
function buildJam(){
  const slots=slotJam();
  $('#inJamMulai').innerHTML=slots.map(s=>`<option>${s}</option>`).join('');
  $('#inJamSelesai').innerHTML='<option value="">—</option>'+slots.map(s=>`<option>${s}</option>`).join('');
}
const jamToMin=s=>{const[h,m]=s.split('.').map(Number);return h*60+m;};
function defaultJam(){
  const slots=slotJam(), mins=slots.map(jamToMin);
  let chosen='08.00';
  if($('#inTanggal').value===todayISO()){
    const n=new Date(), cur=n.getHours()*60+n.getMinutes();
    const idx=mins.reduce((acc,v,i)=>v<=cur?i:acc,-1);
    if(idx>=0)chosen=slots[idx];
  }
  $('#inJamMulai').value=chosen;
  $('#inJamSelesai').value=slots[Math.min(slots.indexOf(chosen)+1,slots.length-1)];
}

/* ================== JAM & TANGGAL BERJALAN (kop) ================== */
function tick(){
  const n=new Date(),p=v=>String(v).padStart(2,'0');
  $('#jamLive').textContent=p(n.getHours())+'.'+p(n.getMinutes())+'.'+p(n.getSeconds());
  $('#tglLive').textContent=HARI[n.getDay()]+', '+n.getDate()+' '+BULAN[n.getMonth()]+' '+n.getFullYear();
}

/* ================== NAVIGASI TAB ================== */
function showTab(name){
  $$('.tab').forEach(b=>b.classList.toggle('active',b.dataset.tab===name));
  ['dashboard','absensi','info'].forEach(t=>{$('#sec-'+t).hidden=(t!==name);});
  const sec=$('#sec-'+name);
  sec.classList.remove('sec');void sec.offsetWidth;sec.classList.add('sec');
  if(name==='dashboard')renderDashboard();
  if(name==='info')renderInfo();
}

/* ================== TOAST & MODAL KONFIRMASI ================== */
let toastTimer;
function showToast(msg,ok=true){
  const t=$('#toast');
  t.innerHTML=`<i data-lucide="${ok?'check':'x'}"></i><span>${esc(msg)}</span>`;
  t.classList.toggle('bad',!ok);t.classList.toggle('ok',ok);
  refreshIcons();t.classList.add('show');
  clearTimeout(toastTimer);toastTimer=setTimeout(()=>t.classList.remove('show'),3200);
}
let confirmCb=null;
function openConfirm(title,msg,cb){
  $('#modalTitle').textContent=title;$('#modalMsg').textContent=msg;
  confirmCb=cb;$('#modalBack').hidden=false;
}
function closeConfirm(){$('#modalBack').hidden=true;confirmCb=null;}
 $('#modalNo').onclick=closeConfirm;
 $('#modalBack').addEventListener('click',e=>{if(e.target===e.currentTarget)closeConfirm();});
 $('#modalYes').onclick=()=>{const cb=confirmCb;closeConfirm();cb&&cb();};

/* ================== DATA PEGAWAI (langkah 1) ================== */
const F={nama:$('#inNama'),nip:$('#inNip'),jab:$('#inJabatan'),sub:$('#inSubbag'),div:$('#inDivisi')};
function updateKop(){
  const p=getPegawai();
  const unit=p?[(p.subbag||'').toUpperCase(),(p.divisi||'').toUpperCase()].filter(Boolean).join(' · '):'';
  $('#kopInstansi').textContent=unit||'INSTANSI / UNIT KERJA';
}
function prefPegawai(){
  const p=getPegawai();if(!p)return;
  F.nama.value=p.nama||'';F.nip.value=p.nip||'';F.jab.value=p.jabatan||'';F.sub.value=p.subbag||'';F.div.value=p.divisi||'';
}
function stepDone(scroll=true){
  const p=getPegawai();if(!p)return;
  $('#chipNama').textContent=p.nama;
  $('#chipNip').textContent='NIP '+p.nip;
  $('#chipRole').textContent=[p.jabatan,p.subbag,p.divisi].filter(Boolean).join(' · ');
  $('#pegawaiChip').hidden=false;
  $('#panelPegawai').hidden=true;
  $('#panelHarian').hidden=false;
  $('#step1').classList.add('done');$('#step1').classList.remove('active');
  $('#step2').classList.add('active');
  updateKop();renderDashboard();
  if(scroll)$('#panelHarian').scrollIntoView({behavior:'smooth',block:'start'});
}
function openPegawaiPanel(){
  prefPegawai();
  $('#panelPegawai').hidden=false;
  $('#pegawaiChip').hidden=true;
  $('#panelHarian').hidden=true;
  $('#step1').classList.remove('done');$('#step1').classList.add('active');
  $('#step2').classList.remove('active');
  setTimeout(()=>F.nama.focus(),80);
}
 $('#btnUbahPegawai').onclick=openPegawaiPanel;

F.nip.addEventListener('input',()=>{F.nip.value=F.nip.value.replace(/\D/g,'').slice(0,18);});
 $$('#formPegawai input').forEach(el=>el.addEventListener('input',()=>el.classList.remove('err')));

 $('#formPegawai').addEventListener('submit',e=>{
  e.preventDefault();
  let ok=true;
  [F.nama,F.nip,F.jab].forEach(el=>{el.classList.remove('err');if(!el.value.trim()){el.classList.add('err');ok=false;}});
  if(!ok){showToast('Lengkapi nama, NIP, dan jabatan dulu ya.',false);return;}
  const nip=F.nip.value.replace(/\D/g,'');
  if(nip.length!==18){F.nip.classList.add('err');showToast('NIP harus tepat 18 digit angka.',false);return;}
  setPegawai({nama:F.nama.value.trim(),nip,jabatan:F.jab.value.trim(),subbag:F.sub.value.trim(),divisi:F.div.value.trim()});
  stepDone();
  showToast('Data pegawai tersimpan.');
});

/* ================== AKTIVITAS HARIAN (langkah 2) ================== */
function syncHariLabel(){$('#inHari').value=$('#inTanggal').value?namaHari($('#inTanggal').value):'—';}
 $('#inTanggal').addEventListener('change',()=>{syncHariLabel();defaultJam();});
 $$('#formHarian input, #formHarian select, #formHarian textarea').forEach(el=>el.addEventListener('input',()=>el.classList.remove('err')));

function stampNow(){
  const st=$('#stamp');
  st.classList.remove('show');st.style.transition='';st.style.opacity='';
  void st.offsetWidth;
  st.classList.add('show');
  setTimeout(()=>{st.style.transition='opacity .5s ease';st.style.opacity='0';},1000);
  setTimeout(()=>{st.classList.remove('show');st.style.transition='';st.style.opacity='';},1550);
}

 $('#formHarian').addEventListener('submit',e=>{
  e.preventDefault();
  const need=[['#inTanggal',1],['#inJamMulai',1],['#inTupoksi',1],['#inRHK',1],['#inTugas',1],['#inRealisasi',1]];
  let ok=true;
  need.forEach(([id])=>{const el=$(id);el.classList.remove('err');if(!el.value.trim()){el.classList.add('err');ok=false;}});
  if(!ok){showToast('Lengkapi isian yang ditandai merah.',false);return;}
  const js=$('#inJamSelesai').value;
  if(js && jamToMin(js)<=jamToMin($('#inJamMulai').value)){
    $('#inJamSelesai').classList.add('err');showToast('Jam selesai harus lebih besar dari jam mulai.',false);return;
  }
  const p=getPegawai()||{nama:'—',nip:'—',jabatan:'',subbag:'',divisi:''};
  const entry={
    id:Date.now()+'-'+Math.random().toString(36).slice(2,7), createdAt:Date.now(),
    tanggal:$('#inTanggal').value, jamMulai:$('#inJamMulai').value, jamSelesai:js,
    tupoksi:$('#inTupoksi').value.trim(), rhk:$('#inRHK').value.trim(), tugas:$('#inTugas').value.trim(),
    kategori:$('#inKategori').value, keterangan:$('#inKet').value.trim(), realisasi:$('#inRealisasi').value.trim(),
    pegawai:{nama:p.nama,nip:p.nip,jabatan:p.jabatan||'',subbag:p.subbag||'',divisi:p.divisi||''}
  };
  const arr=getEntries();arr.push(entry);saveEntries(arr);
  stampNow();
  showToast('Aktivitas tercatat. Jangan lupa salin ke e-Kinerja BKN.');
  // Reset sebagian: tupoksi, RHK, kategori, tanggal dipertahankan karena biasanya sama
  $('#inTugas').value='';$('#inKet').value='';$('#inRealisasi').value='';
  defaultJam();
  renderDashboard();renderInfo();
  $('#inTugas').focus();
});

 $('#btnResetHarian').onclick=()=>{
  $('#inTugas').value='';$('#inKet').value='';$('#inRealisasi').value='';
  defaultJam();showToast('Isian dibersihkan.');
};

/* ================== DASHBOARD ================== */
const sortDesc=a=>[...a].sort((x,y)=>x.tanggal===y.tanggal?y.createdAt-x.createdAt:(x.tanggal<y.tanggal?1:-1));

function renderDashboard(){
  const p=getPegawai(), list=getEntries(), box=$('#dashId');
  if(p){
    box.innerHTML=`<div class="idcard">
      <div class="idcard-top"><i data-lucide="user"></i> IDENTITAS PELAPOR</div>
      <div class="idcard-name">${esc(p.nama)}</div>
      <div class="idcard-nip">NIP ${esc(p.nip)}</div>
      <div class="idcard-role">${esc([p.jabatan,p.subbag,p.divisi].filter(Boolean).join(' · '))}</div>
      <button class="btn btn-sm" data-edit="1"><i data-lucide="pencil"></i> Ubah identitas</button>
    </div>`;
  }else{
    box.innerHTML=`<div class="empty" style="margin-bottom:20px">
      <i data-lucide="user"></i><b>Belum ada identitas pegawai</b>
      Mulai dengan mengisi data diri pada menu Absensi.<br>
      <button class="btn btn-primary" data-goabsen="1">Isi Data Pegawai <i data-lucide="arrow-right"></i></button>
    </div>`;
  }
  const today=todayISO();
  $('#stTotal').textContent=list.length;
  $('#stToday').textContent=list.filter(e=>e.tanggal===today).length;
  $('#stTraj').textContent=list.filter(e=>e.kategori==='trajectory').length;
  $('#stNon').textContent=list.filter(e=>e.kategori!=='trajectory').length;

  const recent=sortDesc(list).slice(0,5);
  $('#recentCount').textContent=list.length?list.length+' catatan tersimpan':'';
  const rl=$('#recentList');
  if(!recent.length){
    rl.innerHTML=`<div class="empty"><i data-lucide="inbox"></i><b>Belum ada aktivitas</b>Catat hasil kerja pertamamu di menu Absensi.</div>`;
  }else{
    rl.innerHTML=recent.map(e=>{
      const d=parseISO(e.tanggal);
      const jam=e.jamSelesai?`${e.jamMulai}–${e.jamSelesai}`:e.jamMulai;
      return `<div class="recent-item">
        <div class="recent-date"><b>${String(d.getDate()).padStart(2,'0')}</b><span>${BULAN_S[d.getMonth()]}</span></div>
        <div class="recent-body">
          <p class="recent-task">${esc(e.tugas)}</p>
          <p class="recent-meta">${jam} · ${esc(e.tupoksi)}${e.realisasi?' · '+esc(e.realisasi):''}</p>
        </div>
        <span class="badge ${e.kategori==='trajectory'?'b-traj':'b-non'}">${e.kategori==='trajectory'?'Trajectory':'Non-Traj'}</span>
      </div>`;}).join('');
  }
  refreshIcons();
}
// tombol dinamis di dashboard
 $('#dashId').addEventListener('click',e=>{
  if(e.target.closest('[data-edit]')){showTab('absensi');openPegawaiPanel();}
  if(e.target.closest('[data-goabsen]'))showTab('absensi');
});

/* ================== INFO ABSENSI ================== */
function renderInfo(){
  const q=($('#fSearch').value||'').toLowerCase().trim();
  const kat=$('#fKategori').value, tgl=$('#fTanggal').value;
  let list=getEntries();const total=list.length;
  if(q)list=list.filter(e=>[e.tugas,e.tupoksi,e.rhk,e.keterangan,e.realisasi,e.pegawai&&e.pegawai.nama]
    .map(x=>String(x||'').toLowerCase()).some(s=>s.includes(q)));
  if(kat)list=list.filter(e=>e.kategori===kat);
  if(tgl)list=list.filter(e=>e.tanggal===tgl);
  list=sortDesc(list);
  $('#infoCount').textContent=`Menampilkan ${list.length} dari ${total} catatan.`;
  const has=list.length>0;
  $('#tblPanel').hidden=!has;$('#infoEmpty').hidden=has;
  if(!has){$('#infoBody').innerHTML='';return;}
  $('#infoBody').innerHTML=list.map((e,i)=>{
    const p=e.pegawai||{};
    const jam=e.jamSelesai?`${e.jamMulai} – ${e.jamSelesai}`:e.jamMulai;
    return `<tr>
      <td class="td-idx">${String(i+1).padStart(2,'0')}</td>
      <td class="td-date"><b>${fmtShort(e.tanggal)}</b>
        <div class="td-sub">${namaHari(e.tanggal)}</div>
        <div class="td-sub mono">${jam}</div></td>
      <td class="td-task">${esc(e.tugas)}
        <div class="td-sub">${esc(e.tupoksi)}${e.rhk?` · RHK: ${esc(e.rhk)}`:''}</div>
        ${p.nama?`<div class="td-sub">${esc(p.nama)}${p.subbag?' — '+esc(p.subbag):''}</div>`:''}
        ${e.keterangan?`<div class="td-sub"><em>${esc(e.keterangan)}</em></div>`:''}</td>
      <td><span class="badge ${e.kategori==='trajectory'?'b-traj':'b-non'}">${e.kategori==='trajectory'?'Trajectory':'Non-Trajectory'}</span></td>
      <td>${esc(e.realisasi)}</td>
      <td><button class="icon-btn" data-del="${e.id}" title="Hapus catatan"><i data-lucide="trash-2"></i></button></td>
    </tr>`;}).join('');
  refreshIcons();
}
['#fSearch','#fKategori','#fTanggal'].forEach(id=>$(id).addEventListener('input',renderInfo));

 $('#infoBody').addEventListener('click',e=>{
  const b=e.target.closest('[data-del]');if(!b)return;
  const en=getEntries().find(x=>x.id===b.dataset.del);if(!en)return;
  openConfirm('Hapus catatan ini?',
    `"${en.tugas.slice(0,80)}" pada ${fmtFull(en.tanggal)} akan dihapus permanen dari perangkat ini.`,
    ()=>{saveEntries(getEntries().filter(x=>x.id!==en.id));renderInfo();renderDashboard();showToast('Catatan dihapus.',false);});
});
 $('#btnHapusSemua').onclick=()=>{
  const n=getEntries().length;
  if(!n){showToast('Belum ada data untuk dihapus.',false);return;}
  openConfirm('Hapus SEMUA catatan?',
    `Seluruh ${n} catatan akan dihapus dari perangkat ini. Pertimbangkan mengunduh CSV terlebih dulu.`,
    ()=>{saveEntries([]);renderInfo();renderDashboard();showToast('Semua catatan dihapus.',false);});
};

/* ================== EKSPOR & CETAK ================== */
 $('#btnCSV').onclick=()=>{
  const list=sortDesc(getEntries());
  if(!list.length){showToast('Belum ada data untuk diekspor.',false);return;}
  const head=['Nama','NIP','Jabatan','Subbag','Divisi','Tanggal','Hari','Jam Mulai','Jam Selesai','Tupoksi','Rencana Hasil Kerja','Tugas Harian','Kategori','Keterangan','Realisasi'];
  const rows=list.map(e=>{const p=e.pegawai||{};return[p.nama,p.nip,p.jabatan,p.subbag,p.divisi,e.tanggal,namaHari(e.tanggal),e.jamMulai,e.jamSelesai,e.tupoksi,e.rhk,e.tugas,e.kategori==='trajectory'?'Trajectory':'Non-Trajectory',e.keterangan,e.realisasi];});
  const csv='\uFEFF'+[head,...rows].map(r=>r.map(v=>`"${String(v??'').replace(/"/g,'""')}"`).join(';')).join('\r\n');
  const a=document.createElement('a');
  a.href=URL.createObjectURL(new Blob([csv],{type:'text/csv;charset=utf-8'}));
  a.download='catatan-kinerja-'+todayISO()+'.csv';a.click();
  URL.revokeObjectURL(a.href);
  showToast('CSV berhasil diunduh.');
};
 $('#btnPrint').onclick=()=>window.print();

/* ================== INISIALISASI ================== */
 $$('.tab').forEach(b=>b.addEventListener('click',()=>showTab(b.dataset.tab)));
buildJam();
 $('#inTanggal').value=todayISO();
syncHariLabel();defaultJam();
if(getPegawai())stepDone(false);else openPegawaiPanel();
updateKop();renderDashboard();renderInfo();
tick();setInterval(tick,1000);
refreshIcons();
</script>
</body>
</html>
